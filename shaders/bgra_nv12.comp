// BGRA (bytes B, G, R, A/X) -> pitch-linear NV12, BT.709 video range, bit-exact with the CPU
// conversion it replaces (src/video/enc/layout.rs bgra_rows): the same fixed-point coefficients,
// rounding and arithmetic right shifts, chroma from the 2x2 sum, the last column and row repeated
// for odd sizes. One invocation: 4 columns x 2 rows of luma and the 2 CbCr pairs below them.
// Columns past the width land in the row padding of the outputs (pitches are 64-byte multiples).
#version 450
layout(local_size_x = 16, local_size_y = 8) in;
layout(set = 0, binding = 0, std430) readonly buffer Src { uint px[]; };
layout(set = 0, binding = 1, std430) writeonly buffer Luma { uint luma[]; };
layout(set = 0, binding = 2, std430) writeonly buffer Chroma { uint chroma[]; };
layout(push_constant) uniform Push {
    uint width;
    uint height;
    uint src_pitch;    // bytes
    uint luma_pitch;   // bytes
    uint chroma_pitch; // bytes
} p;

ivec3 rgb(uint x, uint y)
{
    uint v = px[(y * p.src_pitch) / 4u + x];
    return ivec3(int((v >> 16) & 255u), int((v >> 8) & 255u), int(v & 255u));
}

uint y_of(ivec3 c)
{
    return uint(16 + ((47 * c.r + 157 * c.g + 16 * c.b + 128) >> 8)) & 255u;
}

void main()
{
    uint x0 = gl_GlobalInvocationID.x * 4u;
    uint y0 = gl_GlobalInvocationID.y * 2u;
    if (x0 >= p.width || y0 >= p.height)
        return;
    uint last = p.width - 1u;
    uint y1 = min(y0 + 1u, p.height - 1u);
    uint l0 = 0u, l1 = 0u;
    for (uint i = 0u; i < 4u; i++) {
        uint x = min(x0 + i, last);
        l0 |= y_of(rgb(x, y0)) << (8u * i);
        l1 |= y_of(rgb(x, y1)) << (8u * i);
    }
    luma[(y0 * p.luma_pitch) / 4u + x0 / 4u] = l0;
    if (y0 + 1u < p.height)
        luma[((y0 + 1u) * p.luma_pitch) / 4u + x0 / 4u] = l1;
    uint uv = 0u;
    for (uint j = 0u; j < 2u; j++) {
        uint xa = min(x0 + 2u * j, last);
        uint xb = min(x0 + 2u * j + 1u, last);
        ivec3 s = rgb(xa, y0) + rgb(xb, y0) + rgb(xa, y1) + rgb(xb, y1);
        uint u = uint(128 + ((-26 * s.r - 87 * s.g + 112 * s.b + 512) >> 10)) & 255u;
        uint v = uint(128 + ((112 * s.r - 102 * s.g - 10 * s.b + 512) >> 10)) & 255u;
        uv |= (u | v << 8u) << (16u * j);
    }
    chroma[((y0 / 2u) * p.chroma_pitch) / 4u + x0 / 4u] = uv;
}

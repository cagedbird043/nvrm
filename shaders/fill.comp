// Test kernel for the video compute engine: data[i] = seed + i * step for i < count.
#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) buffer Out { uint data[]; };
layout(push_constant) uniform Push { uint count; uint seed; uint step; } p;
void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i < p.count)
        data[i] = p.seed + i * p.step;
}
